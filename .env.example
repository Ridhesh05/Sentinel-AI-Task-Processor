# ──────────────────────────────────────────────────────────────────
# Sentinel AI Task Processor — Environment Variables Template
# Copy this file to .env in the project root and fill in real values.
# NEVER commit .env to version control (it is gitignored).
# ──────────────────────────────────────────────────────────────────

# ── Gemini AI ────────────────────────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── PostgreSQL ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel_db
DB_USER=sentinel
DB_PASSWORD=sentinel

# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SOCKET_TIMEOUT=5

# ── API Service ──────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Rate limiting: max requests per window per client
RATE_LIMIT=10
RATE_WINDOW=60
# Max length of input_text (characters)
INPUT_TEXT_MAX_LENGTH=5000
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Worker Service ───────────────────────────────────────────────
# Unique worker name (useful when scaling with multiple containers)
WORKER_NAME=worker-1
# Snowflake node ID (0–1023; each worker instance should have a unique value)
SNOWFLAKE_NODE_ID=0
# Max stream length before trimming (0 = disabled)
STREAM_TRIM_MAXLEN=10000
# Artificial delay before processing each task (0 = no delay)
PROCESSING_DELAY_SEC=0
# Gemini retry config
PROCESS_MAX_RETRIES=3
PROCESS_RETRY_BASE_DELAY_SEC=1.0
# Prometheus metrics port for the worker
METRICS_PORT=9100

# ── Monitor Service ──────────────────────────────────────────────
# Allowed CORS origins for the SSE monitor (use * for unrestricted dev access)
# CORS_ORIGINS=http://localhost:3000
